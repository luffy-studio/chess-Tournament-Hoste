{
  "name": "chess-tournament-platform-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "core/tournament-engine"
  ],
  "scripts": {
    "build:engine": "npm run build --workspace=tournament-engine",
    "build:backend": "npm run build --workspace=chess-backend",
    "build:frontend": "npm run build --workspace=chess-tournament-platform",
    "build": "npm run build:engine && npm run build:backend && npm run build:frontend",
    "dev:frontend": "npm run dev --workspace=chess-tournament-platform",
    "dev:backend": "npm run dev --workspace=chess-backend",
    "dev": "npm run dev:frontend & npm run dev:backend",
    "test:engine": "npm run test --workspace=tournament-engine",
    "test": "npm run test:engine"
  }
}
