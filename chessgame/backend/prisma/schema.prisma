generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                  String               @id @default(uuid())
  username            String               @unique
  password            String               // Hashed password
  role                String               @default("admin") // "admin" or "participant"
  passwordResetTokens PasswordResetToken[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tokenHash])
  @@index([userId])
}

model Tournament {
  id              String               @id @default(uuid())
  name            String
  mode            String               // "swiss" or "roundrobin"
  status          String               @default("setup") // "setup", "ongoing", "completed", "paused"
  currentRound    Int                  @default(1)
  roundsPlanned   Int
  byePoints       Float                @default(1)
  holdName        String?
  winnerId        String?
  winnerName      String?
  championDetails String?              // JSON: { winner, coChampions, tiebreaks }
  participants    Participant[]
  matches         Match[]
  rounds          Round[]
  announcements   Announcement[]
  settings        TournamentSettings?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Participant {
  id             String      @id @default(uuid())
  tournamentId   String
  tournament     Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name           String
  score          Float       @default(0)
  rating         Int         @default(1200)
  nationalRating Int?
  isUnrated      Boolean     @default(true)
  title          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  whiteMatches Match[]     @relation("WhiteParticipant")
  blackMatches Match[]     @relation("BlackParticipant")

  @@unique([tournamentId, name])
  @@index([tournamentId])
  @@index([tournamentId, score])
  @@index([name])
}

model Match {
  id                String          @id @default(uuid())
  tournamentId      String
  tournament        Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round             Int
  board             Int
  whiteId           String?
  blackId           String?
  white             Participant?    @relation("WhiteParticipant", fields: [whiteId], references: [id], onDelete: SetNull)
  black             Participant?    @relation("BlackParticipant", fields: [blackId], references: [id], onDelete: SetNull)
  result            String?         // "W", "L", "D", or null
  isManual          Boolean         @default(false)
  resultDetail      String?
  lastUpdatedBy     String?
  resultConfirmed   Boolean         @default(false)
  resultEnteredAt   DateTime?
  auditLogs         MatchAuditLog[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([tournamentId])
  @@index([tournamentId, round])
  @@index([whiteId])
  @@index([blackId])
  @@index([result])
}

model WebhookEndpoint {
  id          String         @id @default(uuid())
  url         String
  secret      String
  description String?
  events      String       // comma separated
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  webhookLogs WebhookEvent[]
}

model WebhookEvent {
  id          String          @id @default(uuid())
  endpointId  String
  endpoint    WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event       String
  payload     String
  status      String          @default("pending") // "pending", "success", "failed"
  attempts    Int             @default(0)
  lastError   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([endpointId])
  @@index([status])
}

model PairingAuditLog {
  id           String   @id @default(uuid())
  tournamentId String
  round        Int
  action       String   // e.g. "PAIRINGS_GENERATED", "MANUAL_OVERRIDE"
  actor        String   @default("admin")
  details      String   // JSON string
  createdAt    DateTime @default(now())

  @@index([tournamentId])
  @@index([tournamentId, round])
  @@index([createdAt])
}

model Round {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  roundNumber  Int
  status       String     @default("pending") // "pending", "active", "completed"
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())

  @@index([tournamentId])
  @@index([tournamentId, roundNumber])
}

model Announcement {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  message      String
  postedBy     String     @default("admin")
  createdAt    DateTime   @default(now())

  @@index([tournamentId])
  @@index([createdAt])
}

model MatchAuditLog {
  id             String   @id @default(uuid())
  matchId        String
  match          Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  tournamentId   String
  action         String   // "RESULT_SUBMITTED", "RESULT_CORRECTED", "RESULT_CONFIRMED"
  previousResult String?
  newResult      String?
  actorUsername  String
  createdAt      DateTime @default(now())

  @@index([tournamentId])
  @@index([matchId])
  @@index([createdAt])
}

model TournamentSettings {
  id                        String     @id @default(uuid())
  tournamentId              String     @unique
  tournament                Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tiebreakerOrder           String     @default("SB,BH,CUT1,WINS,WINS_BLACK,PROG")
  allowLateRegistration     Boolean    @default(true)
  maxParticipants           Int?
  requireResultConfirmation Boolean    @default(false)
  venue                     String?
  timeControl               String?
  description               String?
  registrationOpen          Boolean    @default(true)
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt
}
